// Keyboard accessory bar — shown above the soft keyboard on mobile/touch
// devices when any input or the terminal is focused.
//
// The bar is position:fixed at the bottom of the visible viewport. With
// windowSoftInputMode=adjustResize (set in splash-styles.xml), the WebView
// shrinks when the keyboard appears, so bottom:0 sits right above the keyboard.

.kb-accessory-bar
  position fixed
  left 0
  right 0
  bottom 0
  z-index 9998
  background var(--main)
  border-top 1px solid var(--border-color, #3a3d42)
  box-shadow 0 -2px 8px rgba(0, 0, 0, 0.25)
  user-select none
  -webkit-user-select none
  -webkit-tap-highlight-color transparent

// Row that holds the pinned hide button + the horizontally scrolling keys.
.kb-accessory-row
  display flex
  align-items center
  gap 6px
  padding 4px 6px

.kb-accessory-scroll
  flex 1 1 auto
  min-width 0
  display flex
  align-items center
  gap 2px
  overflow-x auto
  overflow-y hidden
  scrollbar-width none
  -ms-overflow-style none
  &::-webkit-scrollbar
    display none

.kb-key
  flex-shrink 0
  min-width 36px
  height 34px
  padding 0 8px
  border 1px solid var(--border-color, #3a3d42)
  border-radius 5px
  background var(--terminal-background, #1e2024)
  color var(--text, #cfd6e4)
  font-size 12px
  font-family -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif
  line-height 1
  cursor pointer
  display flex
  align-items center
  justify-content center
  transition background 0.12s, border-color 0.12s

  &:active
    background var(--primary, #4a90d9)
    color #fff
    border-color var(--primary, #4a90d9)

// Highlighted toggle (Ctrl / Alt active)
.kb-key-active
  background var(--primary, #4a90d9)
  color #fff
  border-color var(--primary, #4a90d9)

.kb-key-done
  background var(--primary, #4a90d9)
  color #fff
  border-color var(--primary, #4a90d9)
  font-weight 600
  margin-left 4px

  &:active
    opacity 0.7

// Hide (collapse) button — pinned to the left of the bar, outside the scroll
// area, so it is always reachable even when the key row is scrolled to the end.
.kb-key-hide
  flex-shrink 0
  font-size 15px
  opacity 0.8
  &:active
    opacity 0.55

// Floating "bring the bar back" button shown while the bar is collapsed.
.kb-accessory-show
  position fixed
  right 10px
  bottom 10px
  z-index 9998
  width 36px
  height 36px
  border-radius 50%
  border 1px solid var(--border-color, #3a3d42)
  background var(--primary, #4a90d9)
  color #fff
  font-size 16px
  line-height 1
  display flex
  align-items center
  justify-content center
  box-shadow 0 2px 8px rgba(0, 0, 0, 0.3)
  cursor pointer
  user-select none
  -webkit-user-select none
  -webkit-tap-highlight-color transparent
  &:active
    opacity 0.7

.kb-key-wide
  min-width 48px

.kb-key-enter
  min-width 44px

.kb-accessory-hint
  padding 2px 10px 4px
  font-size 10px
  color var(--text-light, #8b909f)
  text-align center

// ---------------------------------------------------------------------------
// Reserve space so the accessory bar never covers page content.
//
// The bar publishes its live height as --kb-bar-h (in px) on :root via JS
// (KeyboardAccessoryBar._syncBarHeight). It is set to the bar's pixel height
// while the bar is visible & expanded, and 0 otherwise — so these rules are
// no-ops unless the bar is actually on screen.
:root
  --kb-bar-h 0px

.is-mobile
  // Lift the footer (which carries the batch input) so its own input is not
  // hidden behind the bar. .main-footer is position:absolute; bottom:0.
  .main-footer
    bottom var(--kb-bar-h, 0px)
  // Shrink the terminal area by the bar height so the last terminal rows are
  // not covered. border-box keeps .term-wrap inside its layout cell; xterm's
  // FitAddon re-measures the (now shorter) .xterm and drops rows accordingly.
  .term-wrap
    box-sizing border-box
    padding-bottom var(--kb-bar-h, 0px)
  // Fullscreen terminal: term-wrap-1 is the inset box (bottom:10px).
  &.fullscreen
    .session-wrap.session-current
      .term-wrap-1
        bottom calc(10px + var(--kb-bar-h, 0px)) !important
